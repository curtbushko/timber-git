{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "(Write|Edit|MultiEdit)",
        "hooks": [
          {
            "type": "command",
            "command": "make build",
            "description": "Build the project after editing files"
          },
          {
            "type": "command",
            "command": "make test",
            "description": "Run tests after editing files"
          },
          {
            "type": "command",
            "command": "make lint",
            "description": "Run linting after editing files"
          }
        ]
      }
    ]
  }
}
